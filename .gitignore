# Python and tooling
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Data: hosted on Hugging Face, pinned in configs/config.yaml.
# Only the manifest (hashes checked at runtime) is committed.
data/*
!data/manifest.json

# Models, checkpoints, MediaPipe weights
/models/
*.pt
*.onnx
*.task

# Generated images that contain signers' faces
reports/samples/

# Machine-specific graph analysis cache
graphify-out/cache/
graphify-out/.graphify_root
graphify-out/.graphify_python
graphify-out/.graphify_health.json

# Secrets and local settings
.env
.claude/settings.local.json
